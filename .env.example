# FOODARA AI - Environment Variables
# Copy to .env and update values

# ============================================
# APPLICATION
# ============================================
APP_NAME=FOODARA AI
APP_VERSION=2.0.0
APP_ENV=development
DEBUG=True

# ============================================
# API
# ============================================
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1

# ============================================
# SECURITY
# ============================================
SECRET_KEY=your-secret-key-change-this-in-production-must-be-strong
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================
# DATABASE
# ============================================
DB_ENGINE=postgresql
DB_HOST=postgres
DB_PORT=5432
DB_USER=foodara
DB_PASSWORD=foodara_password_dev
DB_NAME=foodara_db

# Async connection string for SQLAlchemy
# Si se define, tiene prioridad sobre los campos DB_* separados.
DATABASE_URL=postgresql+asyncpg://foodara:foodara_password_dev@postgres:5432/foodara_db

# ============================================
# AI PROVIDERS
# ============================================

# OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_ENABLED=False

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-3-opus-20240229
ANTHROPIC_ENABLED=True

# Local AI (futuro)
LOCAL_AI_ENABLED=False
LOCAL_AI_URL=http://localhost:8001

# Default provider
DEFAULT_AI_PROVIDER=anthropic

# ============================================
# VISION & OCR
# ============================================
VISION_ENABLED=False
VISION_PROVIDER=mock
VISION_CONFIDENCE_THRESHOLD=0.7

OCR_ENABLED=False
OCR_PROVIDER=mock

# ============================================
# THIRD PARTY SERVICES
# ============================================

# Stripe (futuro)
STRIPE_API_KEY=sk_test_your_key_here
STRIPE_ENABLED=False

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000", "http://127.0.0.1:3000"]

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ============================================
# ARGENTINA DEFAULTS
# ============================================
CURRENCY=ARS
LANGUAGE=es
TIMEZONE=America/Argentina/Buenos_Aires
COUNTRY=AR
